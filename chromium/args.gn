# ==============================================================================
# SINGULARITY BROWSER — ZERO-TELEMETRY HARDENED CHROMIUM ENGINE BUILD (args.gn)
# ==============================================================================
# Target: libchromiumcontent / CEF C-FFI Embedding Layer for Singularity Rust Core
# Security Posture: Hardened CFI + MiraclePtr + V8 Sandbox + Zero Google Endpoints

# 1. COMPILER & LINKER EXTREME OPTIMIZATION
is_official_build = true
is_debug = false
is_component_build = false
is_clang = true
use_thin_lto = true
thin_lto_enable_optimizations = true
thin_lto_enable_cache = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
use_lld = true
treat_warnings_as_errors = false
chrome_pgo_phase = 0

# 2. COMPLETE GOOGLE TELEMETRY, UMA, UKM, RLZ & SYNC REMOVAL
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
use_official_google_api_keys = false
enable_rlz = false
enable_reporting = false
enable_crash_service = false
enable_nacl = false
enable_remoting = false
enable_google_now = false
enable_one_click_signin = false
enable_dice_support = false
enable_autofill_assistant_api = false
enable_feed_v2 = false
enable_supervised_users = false
enable_screen_ai_service = false
enable_optimization_guide = false
build_with_tflite_lib = false

# 3. SAFE BROWSING, CRASHPAD & BACKGROUND PING ELIMINATION
safe_browsing_mode = 0
enable_safe_browsing = false
use_crash_key_stubs = true
enable_breakpad = false
enable_hangout_services_extension = false
enable_mdns = false
enable_service_discovery = false
enable_wifi_bootstrapping = false
enable_background_mode = false
enable_background_contents = false

# 4. PRIVACY & WEBRTC IP LEAK HARDENING
rtc_use_h264 = true
rtc_include_ilbc = false
rtc_build_examples = false
rtc_build_tools = false
enable_webrtc = true
webrtc_non_local_ip_handling_only = true

# 5. SANDBOXING, CFI, MIRACLEPTR & V8 HARDENING
is_cfi = true
use_cfi_cast = true
use_cfi_icall = true
use_cfi_diag = false
enable_backup_ref_ptr_support = true
enable_dangling_raw_ptr_checks = false
v8_enable_sandbox = true
v8_enable_pointer_compression = true
v8_enable_short_builtin_calls = true
v8_enable_maglev = true
v8_enable_sparkplug = true
v8_enable_turbofan = true
v8_enable_webassembly = true
v8_enable_wasm_simd256_revec = true

# 6. HARDWARE ACCELERATION, MEDIA CODECS & GPU (WGPU / VULKAN / VAAPI / NVDEC)
# NOTICE: This reference args.gn file is not compiled or linked into official Singularity
# releases. Enabling `proprietary_codecs = true` / `ffmpeg_branding = "Chrome"` in custom
# Chromium builds may require third-party patent licenses (e.g., H.264/AAC/HEVC) depending
# on your jurisdiction; set `proprietary_codecs = false` and `ffmpeg_branding = "Chromium"`
# for strictly royalty-free builds.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_av1_decoder = true
enable_dav1d_decoder = true
enable_hevc_parser_and_hw_decoder = true
enable_platform_hevc = true
enable_platform_ac3_eac3_audio = true
enable_platform_dolby_vision = false
enable_platform_mpeg_h_audio = true
enable_mse_mpeg2ts_stream_parser = true
use_vaapi = true
use_v4l2_codec = false
enable_vulkan = true
enable_dawn_backend = true
use_ozone = true
ozone_auto_platforms = false
ozone_platform = "wayland"
ozone_platform_wayland = true
ozone_platform_x11 = true

# 7. STRIP UNUSED BLOAT (WIDEVINE DRM OFF BY DEFAULT, NO PDF/PRINTING/VR/XR)
enable_widevine = false
bundle_widevine_cdm = false
enable_cdm_host_verification = false
enable_cdm_storage_id = false
enable_pdf = false
enable_print_preview = false
enable_printing = false
enable_vr = false
enable_openxr = false
enable_arcore = false
enable_cardboard = false
enable_speech_service = false
enable_extensions = false
enable_plugins = false
